{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/anime/watch/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/anime/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/anime/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/anime/category/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/anime/discovery/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/anime/info/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/anime/search/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/anime/watch/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/movies/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/movies/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/tv/([^/]+?)/season/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/tv/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/tv/?$",
			"dest": "_render"
		},
		{
			"src": "^/browse/?$",
			"dest": "_render"
		},
		{
			"src": "^/movie/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/movies/?$",
			"dest": "_render"
		},
		{
			"src": "^/tv/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/tv/?$",
			"dest": "_render"
		},
		{
			"src": "^/tv-shows/?$",
			"dest": "_render"
		},
		{
			"src": "^/watch/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/watch/?$",
			"dest": "_render"
		},
		{
			"src": "^/watchlist/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}